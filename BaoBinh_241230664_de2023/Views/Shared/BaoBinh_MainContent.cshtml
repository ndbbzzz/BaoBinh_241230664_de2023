@model IEnumerable<BaoBinh_241230664_de2023.Models.HangHoa>

<div class="section group">
    @foreach (var h in Model)
    {
        <div class="grid_1_of_4 images_1_of_4">
            <a href="#"><img src="~/images/@h.Anh" alt="@h.TenHang" /></a>
            <h2>@h.TenHang</h2>
            <div class="price-details">
                <div class="price-number">
                    <p><span class="rupees">@(((decimal)(h.Gia ?? 0)).ToString("N0"))</span></p>
                </div>
                <div class="add-cart"><h4><a href="#">Add to Cart</a></h4></div>
                <div class="clear"></div>
            </div>
        </div>
    }
</div>